# 아래 둘 중 하나의 키만 넣으면 됩니다. (둘 다 비어 있으면 데모 모드)
# 이 파일(.env.example)은 예시입니다. 실제 키는 .env 파일에만 넣고, 절대 공유하지 마세요.

# ChatGPT(OpenAI) 키 — platform.openai.com 에서 발급
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Claude 키 — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 두 키가 다 있을 때 고르기: openai 또는 claude (비워두면 Claude 우선)
AI_PROVIDER=

# 로그인·내 보관함 (Supabase) — supabase.com 프로젝트의 Settings > API 에서 복사
# SUPABASE_ANON_KEY 는 브라우저에 공개되는 키예요. service_role(비밀 키)은 여기에 넣지 마세요.
SUPABASE_URL=
SUPABASE_ANON_KEY=
